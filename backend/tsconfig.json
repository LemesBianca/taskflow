{
  "compilerOptions": {
    "module": "Node16",
    "target": "es2020",
    "rootDir": "src",
    "outDir": "dist",

    "types": ["node"],

    "sourceMap": true,

    "strict": true,

    "esModuleInterop": true,
    "skipLibCheck": true,

    "moduleResolution": "node16"
  },

  "include": [
    "src/**/*"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}